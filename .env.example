# Environment variables for Violet Rally / Set & Slay
# Copy to .env (or set in your hosting provider) and fill in real values.
# Never commit real secrets.

# Resend API key for the footer VIP-list subscription (https://resend.com)
RESEND_API_KEY=

# Resend audience ID the subscribed emails are added to (optional)
RESEND_AUDIENCE_ID=
